{
  "expo": {
    "name": "ShelfScan",
    "slug": "shelfscan",
    "scheme": "shelfscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.formation.shelfscan",
      "infoPlist": {
        "NSCameraUsageDescription": "ShelfScan utilise la caméra pour scanner le code-barres ISBN d'un livre."
      }
    },
    "android": {
      "package": "com.formation.shelfscan",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-dev-client"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "af1bfae8-b3e3-46f7-964d-920cf0c028e8"
      }
    },
    "owner": "vincent-daribo"
  }
}
